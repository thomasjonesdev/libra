<Column grow gap={0}>
  <Row grow>
    <AppRail chrome_background={chrome_background} newNote={newNote} openCommandPalette={openCommandPalette} openDailyNote={openDailyNote} openGraph={openGraph} undo={undo} openVaultPicker={openVaultPicker} openSettings={openSettings} />
    <if test={sidebar_open}>
      <Split fraction={split_list} leftMin={240} onResize={listSplitChanged} testId="list-split">
        <Column grow gap={0}>
          <SidebarToolbar chrome_background={chrome_background} sidebar_files={sidebar_files} sidebar_search={sidebar_search} sidebar_bookmarks={sidebar_bookmarks} showFilesView={showFilesView} showSearchView={showSearchView} showBookmarksView={showBookmarksView} toggleSidebar={toggleSidebar} />
          <SidebarPanel sidebar_search={sidebar_search} query={query} queryChanged={queryChanged} clearQuery={clearQuery}>
            <Column gap={2}>
              <if test={file_rows.isEmpty}>
                <Text muted testId="empty">{empty_message}</Text>
              </if>
              <for each={file_rows} as="n" key={n.id}>
                <ListItem title={n.title} selected={n.selected} inset={n.inset} onPress={selectFile(n.id)} onMenu={fileContext(n.id)} />
              </for>
            </Column>
          </SidebarPanel>
        </Column>
        <Column grow gap={0} padding={0}>
          <if test={has_vault}>
            <Toolbar compact background="surface" testId="editor-toolbar">
              <Button variant="ghost" onPress={goBack} testId="go-back">Back</Button>
              <Button variant="ghost" onPress={goForward} testId="go-forward">Fwd</Button>
              <Tabs testId="editor-tabs">
                <for each={tab_rows} as="t" key={t.id}>
                  <Tab selected={t.selected} onPress={selectNote(t.id)} onClose={closeTab(t.id)}>{t.title}</Tab>
                </for>
              </Tabs>
              <Tooltip text="Open next note in a new tab" position="bottom">
                <Button variant="ghost" icon="plus" onPress={newTab} testId="new-tab" />
              </Tooltip>
              <if test={has_selected}>
                <Spacer />
                <Button variant="ghost" onPress={toggleReaderMode} testId="toggle-mode">{mode_label}</Button>
              </if>
            </Toolbar>
          </if>
          <Column grow gap={0} padding={0}>
            <if test={has_selected}>
              <Scroll testId="editor-scroll">
                <if test={reader_mode}>
                  <Column grow padding={24} gap={8}>
                    <Input variant="plain" size="xl" bold value={title_draft} onChange={titleChanged} onSubmit={titleSubmitted} testId="note-title" />
                    <if test={has_frontmatter}>
                      <Column gap={10}>
                        <Text bold size="sm" muted testId="frontmatter-panel">Properties</Text>
                        <for each={frontmatter_fields} as="f" key={f.key}>
                          <Row gap={12} cross="center">
                            <Text muted size="sm">{f.key}</Text>
                            <Text grow wrap size="sm">{f.value}</Text>
                          </Row>
                        </for>
                        <Textarea value={frontmatter_yaml} placeholder="title: …" onChange={frontmatterChanged} testId="frontmatter-yaml" />
                      </Column>
                      <Separator />
                    </if>
                    <Textarea markdown value={editor_body} onWikilink={followWikilink} placeholder="write a note…" onChange={bodyChanged} testId="reader-body" />
                  </Column>
                  <else>
                    <Column grow padding={24} gap={8}>
                      <Input variant="plain" size="xl" bold value={title_draft} onChange={titleChanged} onSubmit={titleSubmitted} testId="note-title" />
                      <Textarea value={editor_body} placeholder="write a note…" onChange={bodyChanged} testId="editor-body" />
                    </Column>
                  </else>
                </if>
              </Scroll>
              <else>
                <Text muted testId="editor-empty">Select a note</Text>
              </else>
            </if>
          </Column>
          <EditorStatusBar vault_name={vault_name} status={status} word_count={word_count} char_count={char_count} save_busy={save_busy} save_ok={save_ok} />
        </Column>
      </Split>
      <else>
        <Row grow gap={0}>
          <Column gap={0}>
            <CollapsedSidebarToolbar chrome_background={chrome_background} toggleSidebar={toggleSidebar} />
          </Column>
          <Column grow gap={0} padding={0}>
            <if test={has_vault}>
              <Toolbar compact background="surface" testId="editor-toolbar">
                <Button variant="ghost" onPress={goBack} testId="go-back">Back</Button>
                <Button variant="ghost" onPress={goForward} testId="go-forward">Fwd</Button>
                <Tabs testId="editor-tabs">
                  <for each={tab_rows} as="t" key={t.id}>
                    <Tab selected={t.selected} onPress={selectNote(t.id)} onClose={closeTab(t.id)}>{t.title}</Tab>
                  </for>
                </Tabs>
                <Tooltip text="Open next note in a new tab" position="bottom">
                  <Button variant="ghost" icon="plus" onPress={newTab} testId="new-tab" />
                </Tooltip>
                <if test={has_selected}>
                  <Spacer />
                  <Button variant="ghost" onPress={toggleReaderMode} testId="toggle-mode">{mode_label}</Button>
                </if>
              </Toolbar>
            </if>
            <Column grow gap={0} padding={0}>
              <if test={has_selected}>
                <Scroll testId="editor-scroll">
                  <if test={reader_mode}>
                    <Column grow padding={24} gap={8}>
                      <Input variant="plain" size="xl" bold value={title_draft} onChange={titleChanged} onSubmit={titleSubmitted} testId="note-title" />
                      <if test={has_frontmatter}>
                        <Column gap={10}>
                          <Text bold size="sm" muted testId="frontmatter-panel">Properties</Text>
                          <for each={frontmatter_fields} as="f" key={f.key}>
                            <Row gap={12} cross="center">
                              <Text muted size="sm">{f.key}</Text>
                              <Text grow wrap size="sm">{f.value}</Text>
                            </Row>
                          </for>
                          <Textarea value={frontmatter_yaml} placeholder="title: …" onChange={frontmatterChanged} testId="frontmatter-yaml" />
                        </Column>
                        <Separator />
                      </if>
                      <Textarea markdown value={editor_body} onWikilink={followWikilink} placeholder="write a note…" onChange={bodyChanged} testId="reader-body" />
                    </Column>
                    <else>
                      <Column grow padding={24} gap={8}>
                        <Input variant="plain" size="xl" bold value={title_draft} onChange={titleChanged} onSubmit={titleSubmitted} testId="note-title" />
                        <Textarea value={editor_body} placeholder="write a note…" onChange={bodyChanged} testId="editor-body" />
                      </Column>
                    </else>
                  </if>
                </Scroll>
                <else>
                  <Text muted testId="editor-empty">Select a note</Text>
                </else>
              </if>
            </Column>
            <EditorStatusBar vault_name={vault_name} status={status} word_count={word_count} char_count={char_count} save_busy={save_busy} save_ok={save_ok} />
          </Column>
        </Row>
      </else>
    </if>
  </Row>
  <if test={toast_err}>
    <Toast tone="danger" title={toast_title} onDismiss={dismissToast} testId="toast">{status}</Toast>
  </if>
  <if test={show_settings}>
    <SettingsDrawer vault_name={vault_name} vault_path={vault_path} has_rules={has_rules} rules_excerpt={rules_excerpt} closeSettings={closeSettings} />
  </if>
  <if test={show_vault_picker}>
    <VaultPickerDialog has_saved_vaults={has_saved_vaults} closeVaultPicker={closeVaultPicker} browseVault={browseVault}>
      <Column gap={2}>
        <for each={vault_rows} as="v" key={v.id}>
          <ListItem title={v.title} subtitle={v.snippet} selected={v.selected} onPress={switchVault(v.id)} onMenu={removeVault(v.id)} />
        </for>
      </Column>
    </VaultPickerDialog>
  </if>
  <if test={show_mention}>
    <MentionDialog query={mention_query} mentionQueryChanged={mentionQueryChanged} dismiss={closeMention}>
      <Column gap={2}>
        <for each={mention_rows} as="n" key={n.id}>
          <ListItem title={n.title} subtitle={n.snippet} onPress={mentionPick(n.id)} />
        </for>
      </Column>
    </MentionDialog>
  </if>
  <if test={show_command_palette}>
    <CommandPaletteDialog query={palette_query} paletteQueryChanged={paletteQueryChanged} dismiss={closeCommandPalette}>
      <Column gap={2}>
        <for each={palette_rows} as="n" key={n.id}>
          <ListItem title={n.title} subtitle={n.snippet} onPress={palettePick(n.id)} />
        </for>
      </Column>
    </CommandPaletteDialog>
  </if>
  <if test={show_graph}>
    <Drawer side="right" onDismiss={closeGraph} testId="graph-drawer">
      <Heading level={3} testId="graph-title">Links</Heading>
      <Text bold testId="graph-out-label">Outgoing</Text>
      <Column gap={2}>
        <for each={outgoing_rows} as="o" key={o.id}>
          <ListItem title={o.title} subtitle={o.snippet} onPress={graphPick(o.id)} />
        </for>
      </Column>
      <Text bold testId="graph-in-label">Backlinks</Text>
      <if test={graph_loading}>
        <Text muted testId="graph-loading">Scanning…</Text>
      </if>
      <Column gap={2}>
        <for each={backlink_rows} as="b" key={b.id}>
          <ListItem title={b.title} subtitle={b.snippet} onPress={graphPick(b.id)} />
        </for>
      </Column>
    </Drawer>
  </if>
</Column>
