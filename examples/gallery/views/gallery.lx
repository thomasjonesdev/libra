<Column gap={0}>
  <Row gap={8} padding={10} cross="center">
    <Text bold grow>Libra Workbench</Text>
    <Text size="sm" muted testId="selected">{selected_name}</Text>
    <Button variant="ghost" onPress={toggleTheme} testId="theme">{theme}</Button>
  </Row>
  <Separator />

  <Row gap={0} grow>
    <Column gap={2} padding={10} width={200}>
      <Scroll testId="sidebar">
        <Column gap={2}>
          <Text size="sm" muted bold>Layout</Text>
          <for each={layout_rows} as="c" key={c.id}>
            <ListItem title={c.name} selected={c.selected} onPress={select(c.id)} />
          </for>
          <Spacer size={8} />
          <Text size="sm" muted bold>Display</Text>
          <for each={display_rows} as="c" key={c.id}>
            <ListItem title={c.name} selected={c.selected} onPress={select(c.id)} />
          </for>
          <Spacer size={8} />
          <Text size="sm" muted bold>Controls</Text>
          <for each={control_rows} as="c" key={c.id}>
            <ListItem title={c.name} selected={c.selected} onPress={select(c.id)} />
          </for>
          <Spacer size={8} />
          <Text size="sm" muted bold>Data</Text>
          <for each={data_rows} as="c" key={c.id}>
            <ListItem title={c.name} selected={c.selected} onPress={select(c.id)} />
          </for>
        </Column>
      </Scroll>
    </Column>

    <Separator vertical />

    <Column gap={12} padding={16} grow={2}>
      <Text size="xl" bold testId="canvas-title">{selected_name}</Text>
      <Separator />

      <if test={is_button}>
        <Text bold muted>Variants</Text>
        <Row gap={8} cross="center">
          <Button variant="primary" onPress={noop}>Primary</Button>
          <Button variant="secondary" onPress={noop}>Secondary</Button>
          <Button variant="ghost" onPress={noop}>Ghost</Button>
        </Row>
        <Text bold muted>Playground</Text>
        <Row gap={8}>
          <Button variant="secondary" onPress={noop} testId="pg-button">{ctl_label}</Button>
        </Row>
      </if>

      <if test={is_badge}>
        <Text bold muted>Variants</Text>
        <Row gap={8} cross="center">
          <Badge>neutral</Badge>
          <Badge tone="success">success</Badge>
          <Badge tone="danger">danger</Badge>
          <Badge tone="warning">warning</Badge>
          <Badge tone="info">info</Badge>
        </Row>
        <Text bold muted>Playground</Text>
        <Row gap={8}>
          <Badge tone="info">{ctl_label}</Badge>
        </Row>
      </if>

      <if test={is_heading}>
        <Text bold muted>Levels</Text>
        <Heading level={1}>Heading 1</Heading>
        <Heading level={2}>Heading 2</Heading>
        <Heading level={3}>Heading 3</Heading>
        <Heading level={4}>Heading 4</Heading>
        <Text bold muted>Playground</Text>
        <Heading level={2}>{ctl_label}</Heading>
      </if>

      <if test={is_progress}>
        <Text bold muted>Variants</Text>
        <Row><Progress value={0.0} /></Row>
        <Row><Progress value={0.25} /></Row>
        <Row><Progress value={0.6} testId="pg-progress" /></Row>
        <Row><Progress value={1.0} /></Row>
        <Text bold muted>Playground (bound to state)</Text>
        <Row><Progress value={ctl_progress} testId="pg-progress-bound" /></Row>
      </if>

      <if test={is_text}>
        <Text bold muted>Sizes</Text>
        <Row gap={12} cross="center">
          <Text size="sm">sm text</Text>
          <Text size="md">md text</Text>
          <Text size="xl">xl text</Text>
        </Row>
        <Text bold muted>Emphasis</Text>
        <Row gap={12} cross="center">
          <Text bold>bold</Text>
          <Text muted>muted</Text>
        </Row>
        <Text bold muted>Playground</Text>
        <Text size="xl">{ctl_label}</Text>
      </if>

      <if test={is_input}>
        <Text bold muted>Playground (type to edit)</Text>
        <Row>
          <Input value={ctl_input} placeholder="empty input (placeholder)" onChange={inputChanged} testId="pg-input" />
        </Row>
        <Spacer />
      </if>

      <if test={is_textarea}>
        <Text bold muted>Playground (multi-line)</Text>
        <Textarea value={ctl_body} placeholder="write something…" onChange={bodyChanged} testId="pg-textarea" />
      </if>

      <if test={is_list_item}>
        <Text bold muted>Variants (right-click the plain row for a menu)</Text>
        <Column gap={2}>
          <ListItem title="Selected row" subtitle="subtitle line" meta="meta line" selected onPress={noop} testId="pg-row-selected" />
          <ListItem title="Plain row (right-click me)" subtitle="subtitle line" onPress={noop} onMenu={openMenu} testId="pg-row-menu" />
          <ListItem title="Title only" onPress={noop} />
        </Column>
      </if>

      <if test={is_split}>
        <Text bold muted>Playground (drag the divider)</Text>
        <Split fraction={ctl_split} onResize={splitChanged} testId="pg-split">
          <Column padding={10}>
            <Text size="sm" muted>left pane</Text>
          </Column>
          <Column padding={10}>
            <Text size="sm" muted>right pane — fraction is model-owned state</Text>
          </Column>
        </Split>
      </if>

      <if test={is_alert}>
        <Text bold muted>Tones</Text>
        <Alert tone="danger" title="Deploy failed">rollback started automatically</Alert>
        <Alert tone="warning" title="Disk almost full">82% of quota used</Alert>
        <Alert tone="success" title="All systems nominal">last check 2m ago</Alert>
        <Alert tone="info" title="Heads up">maintenance window Sunday</Alert>
        <Text bold muted>Playground</Text>
        <Alert tone="info" title={ctl_label} testId="pg-alert">bound title above</Alert>
      </if>

      <if test={is_card}>
        <Text bold muted>Bordered, elevated surface</Text>
        <Card>
          <Text bold>Card title</Text>
          <Text size="sm" muted>Cards share the Dialog panel chrome — one surface language.</Text>
          <Row gap={8}>
            <Button variant="secondary" onPress={noop}>Action</Button>
            <Button variant="ghost" onPress={noop}>Dismiss</Button>
          </Row>
        </Card>
      </if>

      <if test={is_panel}>
        <Text bold muted>Plain surface</Text>
        <Panel>
          <Text size="sm">Panels are the unframed sibling of Card.</Text>
        </Panel>
      </if>

      <if test={is_skeleton}>
        <Text bold muted>Static placeholders (shimmer waits on §9.6)</Text>
        <Skeleton width={220} height={24} />
        <Skeleton />
        <Skeleton width={320} />
        <Skeleton width={180} />
      </if>

      <if test={is_avatar}>
        <Text bold muted>Initials</Text>
        <Row gap={8} cross="center">
          <Avatar name="Ada Lovelace" testId="pg-avatar" />
          <Avatar name="Grace Hopper" size={48} />
          <Avatar name="Turing" size={24} />
        </Row>
        <Text bold muted>Playground (bound name)</Text>
        <Avatar name={ctl_label} size={40} />
      </if>

      <if test={is_switch}>
        <Text bold muted>Playground (model-owned — click it)</Text>
        <Row gap={8} cross="center">
          <Switch checked={switch_on} onToggle={toggleSwitch} testId="pg-switch" />
          <Text size="sm" muted>bound to state</Text>
        </Row>
        <Text bold muted>States</Text>
        <Row gap={8} cross="center">
          <Switch checked onToggle={noop} />
          <Switch onToggle={noop} />
        </Row>
      </if>

      <if test={is_checkbox}>
        <Text bold muted>Playground (model-owned — click it)</Text>
        <Checkbox checked={check_on} onToggle={toggleCheck} testId="pg-checkbox">Stay signed in</Checkbox>
        <Text bold muted>States</Text>
        <Checkbox checked onToggle={noop}>Checked</Checkbox>
        <Checkbox onToggle={noop}>Unchecked</Checkbox>
      </if>

      <if test={is_radio}>
        <Text bold muted>Playground (pick one)</Text>
        <Radio selected={radio_a} onSelect={pickRadioA} testId="pg-radio-a">Option A</Radio>
        <Radio selected={radio_b} onSelect={pickRadioB} testId="pg-radio-b">Option B</Radio>
      </if>

      <if test={is_slider}>
        <Text bold muted>Playground (model-owned — click or drag the track)</Text>
        <Row gap={8} cross="center">
          <Slider value={ctl_slider} onChange={sliderChanged} testId="pg-slider" />
        </Row>
        <Text bold muted>Bound elsewhere: the same value drives a Progress</Text>
        <Row><Progress value={ctl_slider} /></Row>
      </if>

      <if test={is_tooltip}>
        <Text bold muted>Hover the button (tooltips ride the hover input)</Text>
        <Row gap={8}>
          <Tooltip text="Deterministic tooltip — hover is an explicit input">
            <Button variant="secondary" onPress={noop} testId="pg-tip-btn">Hover me</Button>
          </Tooltip>
        </Row>
      </if>

      <if test={is_drawer}>
        <Text bold muted>Playground</Text>
        <Row gap={8}>
          <Button variant="secondary" onPress={openDrawer} testId="pg-open-drawer">Open drawer</Button>
        </Row>
        <Text size="sm" muted>Edge-anchored modal on the Dialog machinery; side="bottom" is the Sheet.</Text>
      </if>
      <if test={drawer_open}>
        <Drawer side="right" onDismiss={closeDrawer} testId="pg-drawer">
          <Text bold>Drawer</Text>
          <Text size="sm" muted>Pinned to the right edge; scrim dismisses.</Text>
          <Button variant="ghost" onPress={closeDrawer} testId="pg-drawer-close">Close</Button>
        </Drawer>
      </if>

      <if test={is_breadcrumb}>
        <Text bold muted>Trail (last crumb is current, non-pressable)</Text>
        <Breadcrumb>
          <BreadcrumbItem label="Home" onPress={noop} />
          <BreadcrumbItem label="Settings" onPress={noop} testId="pg-crumb-mid" />
          <BreadcrumbItem label="Profile" current testId="pg-crumb-current" />
        </Breadcrumb>
      </if>

      <if test={is_pagination}>
        <Text bold muted>Playground (click a page)</Text>
        <Pagination current={ctl_page} total={12} onPage={pageChanged} testId="pg-pagination" />
        <Text size="sm" muted testId="pg-page-label">page {ctl_page}</Text>
      </if>

      <if test={is_stepper}>
        <Text bold muted>Playground (status follows the shared page index)</Text>
        <Stepper current={ctl_page}>
          <StepperItem label="Cart" testId="pg-step-0" />
          <StepperItem label="Shipping" testId="pg-step-1" />
          <StepperItem label="Payment" testId="pg-step-2" />
        </Stepper>
      </if>

      <if test={is_timeline}>
        <Text bold muted>Ledger (done fills the indicator)</Text>
        <Timeline>
          <TimelineItem title="Order placed" meta="2m ago" done testId="pg-tl-0" />
          <TimelineItem title="Shipped" meta="1m ago" done testId="pg-tl-1" />
          <TimelineItem title="Out for delivery" meta="pending" testId="pg-tl-2" />
        </Timeline>
      </if>

      <if test={is_dialog}>
        <Text bold muted>Playground</Text>
        <Row gap={8}>
          <Button variant="secondary" onPress={openDialog} testId="pg-open-dialog">Open dialog</Button>
        </Row>
        <Text size="sm" muted>In-tree modal: scrim + centered panel, deterministic and snapshot-covered. Click the scrim to dismiss.</Text>
      </if>
      <if test={menu_open}>
        <ContextMenu onDismiss={menuClose} testId="pg-menu">
          <Button variant="ghost" onPress={menuClose} testId="pg-menu-a">Menu item A</Button>
          <Button variant="ghost" onPress={menuClose} testId="pg-menu-b">Menu item B</Button>
        </ContextMenu>
      </if>
      <if test={dialog_open}>
        <Dialog title="Workbench dialog" onDismiss={closeDialog} testId="pg-dialog">
          <Text size="sm" muted>Ordinary markup children; the scrim is the modal barrier.</Text>
          <Input value={ctl_input} placeholder="type…" onChange={inputChanged} testId="pg-dialog-input" />
          <Row gap={8}>
            <Spacer />
            <Button variant="ghost" onPress={closeDialog} testId="pg-dialog-close">Close</Button>
          </Row>
        </Dialog>
      </if>

      <if test={is_chart}>
        <Text bold muted>Live (data plane)</Text>
        <Chart series={wave} height={220} testId="pg-chart" />
      </if>

      <if test={is_sparkline}>
        <Text bold muted>Live (data plane)</Text>
        <Row gap={8} cross="center">
          <Sparkline series={wave} width={180} height={44} testId="pg-spark" />
          <Text size="sm" muted>inline mini-chart</Text>
        </Row>
      </if>

      <if test={is_separator}>
        <Text bold muted>Horizontal</Text>
        <Separator />
        <Text bold muted>Vertical (pane seam)</Text>
        <Row gap={8} cross="center">
          <Text muted>left</Text>
          <Separator vertical />
          <Text muted>right</Text>
        </Row>
      </if>

      <if test={is_spacer}>
        <Text bold muted>Spring (bare — pushes siblings apart)</Text>
        <Row gap={8} cross="center">
          <Text muted>left</Text>
          <Spacer />
          <Text muted>right</Text>
        </Row>
        <Text bold muted>Fixed (size=48)</Text>
        <Row gap={8} cross="center">
          <Text muted>a</Text>
          <Spacer size={48} />
          <Text muted>b</Text>
        </Row>
      </if>

      <if test={is_column}>
        <Text bold muted>Column — vertical flex</Text>
        <Column gap={6}>
          <Text>one</Text>
          <Text>two</Text>
          <Text>three</Text>
        </Column>
      </if>

      <if test={is_row}>
        <Text bold muted>Row — horizontal flex</Text>
        <Row gap={6} cross="center">
          <Text>one</Text>
          <Text>two</Text>
          <Text>three</Text>
        </Row>
      </if>
    </Column>

    <Separator vertical />

    <Column gap={8} padding={16} width={240}>
      <Text bold>Controls</Text>
      <if test={has_text_control}>
        <Text size="sm" muted>label</Text>
        <Row>
          <Input value={ctl_label} placeholder="text…" onChange={labelChanged} testId="ctl-label" />
        </Row>
        <Spacer />
        <else>
          <if test={is_progress}>
            <Text size="sm" muted>value: {ctl_progress}</Text>
            <Row gap={6}>
              <Button variant="secondary" onPress={progressDown} testId="ctl-progress-down">−</Button>
              <Button variant="secondary" onPress={progressUp} testId="ctl-progress-up">+</Button>
            </Row>
            <Spacer />
            <else>
              <Text size="sm" muted wrap testId="no-controls">This component's variants are shown at left; it has no text control.</Text>
            </else>
          </if>
        </else>
      </if>
    </Column>
  </Row>
</Column>
