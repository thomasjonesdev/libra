<Column gap={8} padding={12}>
  <Row gap={8} cross="center">
    <Text bold grow>Telemetry — 16 series @ 10 kHz</Text>
    <Text size="sm" muted testId="status">{status}</Text>
    <Button variant="secondary" onPress={toggle} testId="toggle">Pause</Button>
  </Row>
  <Row gap={8} grow>
    <for each={row0} as="s" key={s}>
      <Chart series={s} height={130} />
    </for>
  </Row>
  <Row gap={8} grow>
    <for each={row1} as="s" key={s}>
      <Chart series={s} height={130} />
    </for>
  </Row>
  <Row gap={8} grow>
    <for each={row2} as="s" key={s}>
      <Chart series={s} height={130} />
    </for>
  </Row>
  <Row gap={8} grow>
    <for each={row3} as="s" key={s}>
      <Chart series={s} height={130} />
    </for>
  </Row>
  <if test={running}>
    <Frames onTick={frame} />
  </if>
</Column>
