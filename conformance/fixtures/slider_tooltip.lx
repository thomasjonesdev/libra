<Column gap={8} padding={12}>
  <Slider value={ratio} onChange={nameChanged} testId="bound-slider" />
  <Slider value={0.25} onChange={nameChanged} testId="fixed-slider" />
  <Tooltip text={status}>
    <Button onPress={increment} testId="tip-btn">hover me</Button>
  </Tooltip>
  <Tooltip text="static tip">
    <Text muted>hover target</Text>
  </Tooltip>
</Column>
