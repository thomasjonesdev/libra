<Column gap={12} padding={16}>
  <Row gap={8} cross="center">
    <Text bold grow>Kitchen sink</Text>
    <Text size="sm" muted testId="status">status: {status}</Text>
    <Button variant="ghost" onPress={Reset} testId="reset">Reset</Button>
  </Row>
  <Row gap={8} main="center" cross="center" grow>
    <Button variant="secondary" onPress={Refresh}>Refresh</Button>
    <Text size="xl" testId="count">{count}</Text>
    <Button variant="primary" onPress={Increment} testId="inc">+</Button>
  </Row>
  <Row gap={6} cross="center">
    <Input value={name} placeholder="type a name" onChange={NameChanged} testId="name" />
    <Text testId="mix">Hello {name} — count is {count}!</Text>
  </Row>
  <Row gap={8} grow>
    <Chart series={s0} height={90} testId="chart" />
    <Sparkline series={s0} width={80} height={24} testId="spark" />
  </Row>
</Column>
