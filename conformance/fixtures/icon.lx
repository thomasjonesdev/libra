<Column gap={8} padding={12}>
  <Icon name="plus" testId="plus" />
  <Icon name="search" muted testId="search-icon" />
  <Icon name="settings" />
  <Button variant="ghost" icon="plus" onPress={increment} testId="icon-btn" />
  <Button variant="secondary" icon="search" onPress={reset}>Find</Button>
</Column>
